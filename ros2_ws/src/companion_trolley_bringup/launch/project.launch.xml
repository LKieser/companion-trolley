<launch>
    <!-- Launch base_link -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher" args="$(find-pkg-share companion_trolley_description)/urdf/companion_trolley.urdf" />
    <!-- Launch LiDAR -->
    <include file="$(find-pkg-share companion_trolley_bringup)/launch/lidar.launch.py" />
    <!-- Launch Arduino Serial Manager-->
    <node pkg="my_py_pkg" exec="arduino_serial_manager" />
    <!-- Launch Robot_localization for odom to base_link-->
    <node
    pkg="robot_localization"
    exec="ekf_node"
    name="ekf_filter_node"
    output="screen">
    <param from="$(find-pkg-share companion_trolley_bringup)/config/robot_localization.yaml" />
    </node>
    <!-- Launch UWB -->
    <node pkg="my_py_pkg" exec="uwb_driver" />
    <node pkg="my_py_pkg" exec="target_follower" />
    <!-- Launch temporary target follower -->
    <!-- <node pkg="my_py_pkg" exec="local_planner_tester" /> -->
    <!-- Launch cmd_vel_smoothed to cmd_vel forwarder -->
    <node pkg="my_py_pkg" exec="cmd_vel_smoothed_forward" />
    <!-- Launch Nav2 -->
    <include file="$(find-pkg-share companion_trolley_bringup)/launch/navigation_launch.py">
        <arg name="use_sim_time" value="false"/>
        <arg name="params_file" value="$(find-pkg-share companion_trolley_bringup)/config/nav2_custom_params.yaml"/>
    </include>
</launch>