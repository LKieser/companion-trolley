<?xml version="1.0"?>
<robot name="companion_trolley">

    <!-- Make colors for each section -->
    <material name="grey">
        <color rgba="0.7 0.7 0.7 1" />
    </material>

    <material name="green">
        <color rgba="0 0.6 0 1" />
    </material>

    <material name="white">
        <color rgba="1 1 1 1" />
    </material>

    <link name="base_footprint" />
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <!-- the z value is the radius of the wheel-->
        <origin xyz="0 0 0.05" rpy="0 0 0" />
    </joint>

    <link name="base_link">
        <visual>
            <geometry>
                <!-- size=" x,  y,   z" in meters-->
                <box size="0.4 0.25 0.5" />
            </geometry>
            <!-- origin tells the robot to move xyz or roll, pitch, yaw (in radians)-->
            <origin xyz="0 0 0.25" rpy="0 0 0" />
            <material name="green" />
        </visual>
    </link>

    <!-- LiDAR -->
    <link name="lidar">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.035" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="white" />
        </visual>
    </link>

    <joint name="base_lidar_joint" type="fixed">
        <parent link="base_link" />
        <child link="lidar" />
        <!-- Origin for lidar set 10cm off ground and half the box x value minus the radius of the lidar-->
        <origin xyz="0.18 0 0.1" rpy="0 0 0" />
    </joint>

    <!-- Left Wheel -->
        <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.05" />
            </geometry>
            <!-- x is changed 90 degrees in radians to fix shape of wheel-->
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="white" />
        </visual>
    </link>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel" />
        <!-- Y value moves wheel to edge of robot -->
        <origin xyz="0 0.15 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <!-- Left Wheel -->
    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.05" />
            </geometry>
            <!-- x is changed 90 degrees in radians to fix shape of wheel-->
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="white" />
        </visual>
    </link>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel" />
        <!-- Y value moves wheel to edge of robot -->
        <origin xyz="0 -0.15 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <!-- Caster Wheel Front Right -->
    <link name="caster_wheel_FR">
        <visual>
            <geometry>
                <!-- Radius is half the radius of the wheel -->
                <sphere radius="0.025" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="white" />
        </visual>
    </link>

    <joint name="base_caster_wheel_FR_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_FR" />
        <origin xyz="0.175 0.1 -0.025" rpy="0 0 0" />
    </joint>

    <!-- Caster Wheel Front Left -->
    <link name="caster_wheel_FL">
        <visual>
            <geometry>
                <!-- Radius is half the radius of the wheel -->
                <sphere radius="0.025" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="white" />
        </visual>
    </link>

    <joint name="base_caster_wheel_FL_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_FL" />
        <origin xyz="0.175 -0.1 -0.025" rpy="0 0 0" />
    </joint>

    <!-- Caster Wheel Back Right -->
    <link name="caster_wheel_BR">
        <visual>
            <geometry>
                <!-- Radius is half the radius of the wheel -->
                <sphere radius="0.025" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="white" />
        </visual>
    </link>

    <joint name="base_caster_wheel_BR_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_BR" />
        <origin xyz="-0.175 0.1 -0.025" rpy="0 0 0" />
    </joint>

    <!-- Caster Wheel Back Left -->
    <link name="caster_wheel_BL">
        <visual>
            <geometry>
                <!-- Radius is half the radius of the wheel -->
                <sphere radius="0.025" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="white" />
        </visual>
    </link>

    <joint name="base_caster_wheel_BL_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_BL" />
        <origin xyz="-0.175 -0.1 -0.025" rpy="0 0 0" />
    </joint>
</robot>